+    research.save(archive)
+    prompts = tmp_path / "prompts.txt"
+    prompts.write_text("placeholder\n")
+    monkeypatch.setattr(worker, "_load_bridge", lambda name: SimpleNamespace(install=lambda runtime, codec_factory: type(
+        "Base", (), {"__init__": lambda self: setattr(self, "tempokv_codec", codec_factory())}
+    )))
+    monkeypatch.setitem(sys.modules, "pipeline", SimpleNamespace())
+    monkeypatch.setitem(sys.modules, "pipeline.causal_inference", SimpleNamespace())
+    for name in ("TEMPOKV_HORIZON_FRAMES", "TEMPOKV_NUM_FRAMES", "TEMPOKV_SPAN_FRAMES",
+                 "TEMPOKV_BF16_LAG_FRAMES", "TEMPOKV_INCREMENTAL", "RANK"):
+        monkeypatch.setenv(name, "0")
+    pipeline_cls = worker.install(
+        {"frames": 717, "research_params": str(archive), "prompts": str(prompts), "output_dir": str(tmp_path)},
+        tmp_path,
+    )
+    pipeline = pipeline_cls()
+    assert isinstance(pipeline.tempokv_codec, TempoKVCodec)
+    assert pipeline.tempokv_codec.v_parameters.weight is None
+    assert pipeline.tempokv_codec.v_parameters.factor_a.device.type == "cpu"
+    assert __import__("os").environ["TEMPOKV_INCREMENTAL"] == "1"
+
+    dense_path = tmp_path / "dense.npz"
+    baseline()[3].save(dense_path)
+    monkeypatch.setenv("TEMPOKV_INCREMENTAL", "0")
+    dense_cls = worker.install(
+        {"frames": 717, "research_params": str(dense_path), "prompts": str(prompts), "output_dir": str(tmp_path)},
+        tmp_path,
+    )
+    dense_pipeline = dense_cls()
+    assert isinstance(dense_pipeline.tempokv_codec, ExperimentalCodec)
+    assert __import__("os").environ["TEMPOKV_INCREMENTAL"] == "0"
+
+
+def test_gpu_factorized_decode_status():
+    status = "RUN" if torch.cuda.is_available() else "NOT_RUN"
+    # CPU runs cover the PyTorch reference. The fused Triton kernel declines
+    # factorized spans so CUDA uses that same replay; this process did not
+    # execute it when CUDA is absent.
+    report = {"gpu_factorized_decode": status, "cuda": torch.cuda.is_available()}
+    print(json.dumps(report))
+    assert status == ("RUN" if torch.cuda.is_available() else "NOT_RUN")
