include README.md
recursive-include configs *.json
recursive-include docs *.md
recursive-include scripts *.py
recursive-include self-forcing *.py *.sh *.md
recursive-include longcat *.py *.sh *.md
prune tests
prune parameters
prune results
prune runs
prune outputs
prune traces
global-exclude .nfs* *.py[cod] *.log *.tmp
