+++ b/rebuttal/adapters/experimental_codec.py	2026-11-08 13:39:32.966241081 +0000
@@ -406,3 +406,97 @@
 def load_codec_factory(path: str | Path, device: str = "cpu") -> ExperimentalCodec:
     """Callable suitable for the explicit generation codec_factory hook."""
     return ExperimentalCodec.load(path, device=device)
+
+
+def _temporal_parameters(temporal: ResearchTemporal) -> TemporalParameters | None:
+    """Invert ``ResearchTemporal.from_production`` for per-channel K only."""
+    if temporal.kind != "channel_linear" or temporal.factor_a is not None or temporal.factor_b is not None:
+        return None
+    weights, bias = temporal.weights, temporal.bias
+    if temporal.sharing == "shared":
+        return TemporalParameters(weights[0].contiguous(), bias[0].contiguous())
+    if temporal.sharing == "layer_shared":
+        return TemporalParameters(
+            weights.permute(1, 2, 0, 3).contiguous(),
+            bias.permute(1, 0, 2).contiguous(),
+        )
+    if temporal.sharing == "layer_head":
+        layers, heads = temporal.layers, temporal.heads
+        order, dim = int(weights.shape[1]), int(weights.shape[-1])
+        return TemporalParameters(
+            weights.view(layers, heads, order, order, dim).permute(0, 2, 3, 1, 4).contiguous(),
+            bias.view(layers, heads, order, dim).permute(0, 2, 1, 3).contiguous(),
+        )
+    return None
+
+
+def _cross_parameters(cross: ResearchCross) -> CrossKVParameters | None:
+    """Broadcast shared factors per layer without forming the dense map ``A @ B``."""
+    if cross.kind != "low_rank" or cross.factor_a is None or cross.factor_b is None or cross.weight is not None:
+        return None
+    layers, heads = cross.layers, cross.heads
+    factor_a, factor_b, bias = cross.factor_a, cross.factor_b, cross.bias
+    rank, dim = int(factor_a.shape[-1]), int(factor_a.shape[-2])
+    if cross.sharing == "layer_shared":
+        if tuple(factor_a.shape) != (heads, dim, rank) or tuple(factor_b.shape) != (heads, rank, dim):
+            return None
+        if tuple(bias.shape) != (heads, dim):
+            return None
+        factor_a = factor_a.unsqueeze(0).expand(layers, -1, -1, -1).contiguous()
+        factor_b = factor_b.unsqueeze(0).expand(layers, -1, -1, -1).contiguous()
+        bias = bias.unsqueeze(0).expand(layers, -1, -1).contiguous()
+    elif cross.sharing == "layer_head":
+        factor_a = factor_a.contiguous().view(layers, heads, dim, rank)
+        factor_b = factor_b.contiguous().view(layers, heads, rank, dim)
+        bias = bias.contiguous().view(layers, heads, dim)
+    elif cross.sharing == "head_shared":
+        if factor_a.shape[0] != layers:
+            return None
+        factor_a = factor_a.unsqueeze(1).expand(-1, heads, -1, -1).contiguous()
+        factor_b = factor_b.unsqueeze(1).expand(-1, heads, -1, -1).contiguous()
+        bias = bias.unsqueeze(1).expand(-1, heads, -1).contiguous()
+    elif cross.sharing == "shared":
+        factor_a = factor_a.reshape(1, 1, dim, rank).expand(layers, heads, -1, -1).contiguous()
+        factor_b = factor_b.reshape(1, 1, rank, dim).expand(layers, heads, -1, -1).contiguous()
+        bias = bias.reshape(1, 1, dim).expand(layers, heads, -1).contiguous()
+    else:
+        return None
+    return CrossKVParameters(
+        None,
+        bias,
+        history_weights=cross.history_weights.contiguous(),
+        projection_source="cross_kv",
+        factor_a=factor_a,
+        factor_b=factor_b,
+    )
+
+
+def load_generation_codec(path: str | Path, device: str | torch.device = "cpu"):
+    """Load a research archive, promoting factorized CrossKV onto the production codec.
+
+    Other archives stay on ``ExperimentalCodec`` and keep that loader's CPU default.
+    Factorized K stays the per-channel temporal predictor. Factors are moved to
+    ``device`` once here; later predictions reuse that storage.
+    """
+    experimental = ExperimentalCodec.load(path)
+    temporal_state = getattr(experimental, "temporal", None)
+    cross_state = getattr(experimental, "v_parameters", None)
+    config = getattr(experimental, "config", None)
+    if temporal_state is None or cross_state is None or config is None:
+        return experimental
+    if config.mirrored or config.v_predictor_mode != "cross_kv":
+        return experimental
+    temporal = _temporal_parameters(temporal_state)
+    cross = _cross_parameters(cross_state)
+    if temporal is None or cross is None:
+        return experimental
+    from dataclasses import replace
+    from tempokv.codec import TempoKVCodec
+
+    resolved = torch.device(device)
+    config = replace(
+        experimental.config,
+        use_triton=resolved.type == "cuda",
+        strict_triton=False,
+    )
+    return TempoKVCodec(temporal.to(resolved), cross.to(resolved), config)
