diff -ruN a/rebuttal/tests/test_factorized_cross_streaming.py b/rebuttal/tests/test_factorized_cross_streaming.py
--- a/rebuttal/tests/test_factorized_cross_streaming.py	1970-01-01 00:00:00.000000000 +0000
+++ b/rebuttal/tests/test_factorized_cross_streaming.py	2026-11-08 13:40:49.919448524 +0000
@@ -0,0 +1,332 @@
+"""Factorized CrossKV must match the research reference and the production stream."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+import torch
+
+from tempokv.codec import TempoKVCodec, decode_tensor
+from tempokv.config import CodecConfig
+from tempokv.fitting import fit_predictors
+from tempokv.parameters import CrossKVParameters, TemporalParameters
+from rebuttal.adapters.experimental_codec import (
+    ExperimentalCodec,
+    ResearchCross,
+    ResearchTemporal,
+    load_generation_codec,
+)
+from rebuttal.experiments.architecture.cross_low_rank import fit_cross_architecture
+from rebuttal.tests.test_architecture import (
+    baseline,
+    config as architecture_config,
+    test_reference_reproduces_shipped_channel_dense_codec,
+    trace,
+)
+
+
+def _legacy_config(*, stride: int, k_history: int, v_history: int) -> CodecConfig:
+    return CodecConfig(
+        k_bits=2,
+        v_bits=2,
+        anchor_bits=4,
+        group_size=64,
+        stride=stride,
+        k_history_length=k_history,
+        v_history_length=v_history,
+        fit_mode="legacy",
+        use_triton=False,
+        strict_triton=False,
+        residual_mode="asymmetric",
+        scale_dtype="bfloat16",
+        reconstruction_dtype="bfloat16",
+        k_predictor_mode="shared",
+        v_predictor_mode="cross_kv",
+        cross_kv_weight_mode="layer_shared",
+        cross_matmul_precision="ieee",
+    )
+
+
+def _manual_low_rank(*, seed: int, v_history: int, k_history: int = 2, units: int = 4, stride: int = 4):
+    generator = torch.Generator().manual_seed(seed)
+    layers, batch, heads, dim, rank = 2, 1, 2, 64, 8
+    sequence = units * stride
+    temporal = TemporalParameters(
+        torch.randn(k_history, k_history, dim, generator=generator) * 0.2,
+        torch.randn(k_history, dim, generator=generator) * 0.2,
+    )
+    factor_a = torch.randn(heads, dim, rank, generator=generator) * 0.05
+    factor_b = torch.randn(heads, rank, dim, generator=generator) * 0.05
+    bias = torch.randn(heads, dim, generator=generator) * 0.05
+    history = torch.randn(layers, v_history, heads, dim, generator=generator) * 0.1
+    cross = CrossKVParameters(
+        None,
+        bias.unsqueeze(0).expand(layers, -1, -1).contiguous(),
+        history_weights=history,
+        factor_a=factor_a.unsqueeze(0).expand(layers, -1, -1, -1).contiguous(),
+        factor_b=factor_b.unsqueeze(0).expand(layers, -1, -1, -1).contiguous(),
+    )
+    keys = torch.randn(layers, batch, sequence, heads, dim, generator=generator)
+    values = 0.8 * keys + 0.1 * torch.randn(keys.shape, generator=generator)
+    config = _legacy_config(stride=stride, k_history=k_history, v_history=v_history)
+    research = ExperimentalCodec(
+        ResearchTemporal.from_production(temporal, layers, heads),
+        ResearchCross(
+            "low_rank", "layer_shared", bias, history, layers, heads,
+            factor_a=factor_a, factor_b=factor_b,
+        ),
+        config,
+    )
+    production = TempoKVCodec(temporal, cross, config)
+    return config, research, production, keys, values
+
+
+def _bhsd(tensor: torch.Tensor) -> torch.Tensor:
+    return tensor.permute(0, 2, 1, 3).contiguous()
+
+
+def _codes(packed) -> tuple:
+    return (
+        packed.anchor_quant,
+        packed.anchor_scale,
+        packed.residual_quant,
+        packed.residual_scale,
+        packed.residual_zero_point,
+        packed.unit_lengths,
+    )
+
+
+def _assert_same_codes(left, right) -> None:
+    for actual, expected in zip(_codes(left), _codes(right), strict=True):
+        if isinstance(expected, torch.Tensor):
+            assert torch.equal(actual, expected)
+        else:
+            assert actual == expected
+
+
+def _decode(codec: TempoKVCodec, key, value, *, layer: int):
+    return codec.decode(codec.encode(key, value, layer=layer))
+
+
+def _incremental(codec: TempoKVCodec, key, value, *, layer: int, capacity: int):
+    stride = codec.config.stride
+    units = key.shape[2] // stride
+    encoder_k, reconstructed = codec.begin_incremental_primary(
+        key[:, :, :stride], capacity_units=capacity, layer=layer
+    )
+    encoder_v = codec.begin_incremental_secondary(
+        value[:, :, :stride], reconstructed, capacity_units=capacity, layer=layer
+    )
+    for index in range(1, units):
+        start, stop = index * stride, (index + 1) * stride
+        reconstructed = encoder_k.append(key[:, :, start:stop])
+        encoder_v.append(value[:, :, start:stop], source=reconstructed)
+    decoded_k = decode_tensor(encoder_k.packed, use_triton=False)
+    decoded_v = decode_tensor(encoder_v.packed, source=decoded_k, use_triton=False)
+    return decoded_k, decoded_v, encoder_k.packed, encoder_v.packed
+
+
+def test_dense_reference_regression_unchanged():
+    test_reference_reproduces_shipped_channel_dense_codec()
+
+
+def test_factorized_parameters_reject_dense_shortcut_and_roundtrip(tmp_path):
+    factor_a = torch.randn(2, 64, 8)
+    factor_b = torch.randn(2, 8, 64)
+    with pytest.raises(ValueError, match="dense weight"):
+        CrossKVParameters(
+            torch.eye(64).unsqueeze(0).expand(2, -1, -1).contiguous(),
+            torch.zeros(2, 64),
+            factor_a=factor_a,
+            factor_b=factor_b,
+        )
+    factorized = CrossKVParameters(
+        None, torch.randn(2, 64), history_weights=torch.randn(1, 2, 64),
+        factor_a=factor_a, factor_b=factor_b,
+    )
+    assert factorized.weight is None and factorized.factorized
+    path = tmp_path / "factors.npz"
+    factorized.save(path)
+    with path.open("rb") as handle:
+        import numpy as np
+        stored = np.load(handle)
+        assert "weight" not in stored.files
+        assert "factor_a" in stored.files and "factor_b" in stored.files
+    loaded = CrossKVParameters.load(path)
+    assert loaded.weight is None
+    assert torch.equal(loaded.factor_a, factor_a)
+    assert torch.equal(loaded.factor_b, factor_b)
+    dense = CrossKVParameters(torch.randn(2, 64, 64), torch.randn(2, 64), history_weights=torch.randn(1, 2, 64))
+    dense_path = tmp_path / "dense.npz"
+    dense.save(dense_path)
+    restored = CrossKVParameters.load(dense_path)
+    assert restored.factor_a is None and torch.equal(restored.weight, dense.weight)
+
+
+@pytest.mark.parametrize("v_history", [1, 2])
+def test_reference_and_stream_match_across_spans(v_history):
+    _, research, production, keys, values = _manual_low_rank(seed=7, v_history=v_history, units=4, stride=4)
+    assert production.v_parameters.weight is None
+    assert production.v_parameters.factor_a.shape[-1] == 8
+    for layer in range(2):
+        key, value = _bhsd(keys[layer]), _bhsd(values[layer])
+        ref_k, ref_v = research.decode(research.encode(key, value, layer=layer))
+        full_k, full_v = _decode(production, key, value, layer=layer)
+        inc_k, inc_v, packed_k, packed_v = _incremental(production, key, value, layer=layer, capacity=4)
+        assert torch.equal(full_k, ref_k) and torch.equal(full_v, ref_v)
+        assert torch.equal(inc_k, full_k) and torch.equal(inc_v, full_v)
+        ref_packed = research.encode(key, value, layer=layer)
+        got_packed = production.encode(key, value, layer=layer)
+        _assert_same_codes(got_packed.key, ref_packed.key)
+        _assert_same_codes(got_packed.value, ref_packed.value)
+        _assert_same_codes(packed_k, got_packed.key)
+        _assert_same_codes(packed_v, got_packed.value)
+        # A new span re-anchors. It must not carry the previous span's history.
+        for offset in (0, 8):
+            span_k, span_v = key[:, :, offset:offset + 8], value[:, :, offset:offset + 8]
+            span_full = _decode(production, span_k, span_v, layer=layer)
+            span_inc = _incremental(production, span_k, span_v, layer=layer, capacity=2)[:2]
+            assert torch.equal(span_inc[0], span_full[0]) and torch.equal(span_inc[1], span_full[1])
+
+
+def test_short_trace_archive_matches_reference(tmp_path):
+    keys, values = trace(4)
+    cfg = architecture_config()
+    temporal, dense = fit_predictors(
+        keys, values, config=cfg, temporal_ridge=1.0, cross_ridge=0.1, v_history_mode="diagonal"
+    )
+    layers, heads = int(keys.shape[0]), int(keys.shape[-2])
+    baseline = ResearchCross.from_production(dense, "layer_shared", layers, heads)
+    low_rank, _logs = fit_cross_architecture(
+        keys, values, baseline, cfg, kind="low_rank", rank=8, rounds=1, als_steps=2, ridge=0.1
+    )
+    assert low_rank.weight is None and low_rank.factor_a.shape[-1] == 8
+    experimental = ExperimentalCodec(ResearchTemporal.from_production(temporal, layers, heads), low_rank, cfg)
+    path = tmp_path / "low_rank_r8.npz"
+    experimental.save(path)
+    production = load_generation_codec(path, device="cpu")
+    assert isinstance(production, TempoKVCodec)
+    assert production.cross_kv.weight is None
+    assert production.temporal.history_weights.ndim == 3  # per-channel shared K, not a dense map
+    for layer in range(layers):
+        key, value = _bhsd(keys[layer]), _bhsd(values[layer])
+        ref_k, ref_v = experimental.decode(experimental.encode(key, value, layer=layer))
+        got_k, got_v = production.decode(production.encode(key, value, layer=layer))
+        assert torch.equal(got_k, ref_k) and torch.equal(got_v, ref_v)
+        inc_k, inc_v, _, _ = _incremental(production, key, value, layer=layer, capacity=key.shape[2])
+        assert torch.equal(inc_k, got_k) and torch.equal(inc_v, got_v)
+
+
+def test_factors_stay_on_activation_device_without_per_call_copies(monkeypatch):
+    _config, _research, production, keys, values = _manual_low_rank(seed=3, v_history=1)
+    key, value = _bhsd(keys[0]), _bhsd(values[0])
+    for layer in (0, 1):
+        production.encode(key, value, layer=layer)
+    cached = {
+        layer: production._cross_for_layer(key.device, layer) for layer in (0, 1)
+    }
+    pointers = {
+        layer: (item.factor_a.data_ptr(), item.factor_b.data_ptr())
+        for layer, item in cached.items()
+    }
+    factor_shapes = {
+        tuple(item.factor_a.shape) for item in cached.values()
+    } | {tuple(item.factor_b.shape) for item in cached.values()}
+    factor_shapes |= {
+        tuple(production.v_parameters.factor_a.shape),
+        tuple(production.v_parameters.factor_b.shape),
+    }
+    for item in cached.values():
+        assert item.factor_a.device == key.device and item.weight is None
+    seen = []
+    import tempokv.codec as codec_module
+    original = codec_module.cross_projection
+
+    def wrapped(source, parameters, **kwargs):
+        assert parameters.factor_a.device == source.device
+        assert parameters.factor_b.device == source.device
+        assert (parameters.factor_a.data_ptr(), parameters.factor_b.data_ptr()) in pointers.values()
+        seen.append(parameters.factor_a.data_ptr())
+        return original(source, parameters, **kwargs)
+
+    copies = []
+    tensor_to = torch.Tensor.to
+
+    def spy(self, *args, **kwargs):
+        result = tensor_to(self, *args, **kwargs)
+        if tuple(self.shape) in factor_shapes and (
+            result.device != self.device or result.data_ptr() != self.data_ptr()
+        ):
+            copies.append((tuple(self.shape), str(self.device), str(result.device)))
+        return result
+
+    monkeypatch.setattr(codec_module, "cross_projection", wrapped)
+    monkeypatch.setattr(torch.Tensor, "to", spy)
+    for layer in (0, 1):
+        production.encode(key, value, layer=layer)
+        again = production._cross_for_layer(key.device, layer)
+        assert again.factor_a.data_ptr() == pointers[layer][0]
+        assert again.factor_b.data_ptr() == pointers[layer][1]
+    assert seen and copies == []
+    if not torch.cuda.is_available():
+        print("GPU factor-device check: NOT_RUN")
+
+
+def test_dense_archive_stays_on_reference_codec(tmp_path):
+    _cfg, _kp, _vp, research = baseline()
+    path = tmp_path / "dense.npz"
+    research.save(path)
+    loaded = load_generation_codec(path, device="cpu")
+    assert isinstance(loaded, ExperimentalCodec)
+    assert loaded.v_parameters.factor_a is None
+
+
+def test_worker_streams_factorized_codec_and_keeps_reference_batch(tmp_path, monkeypatch):
+    import sys
+    from types import SimpleNamespace
